{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/method-quality-outcome-seal.schema.json",
  "title": "Method Quality Outcome Seal",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "seal_id", "registration_id", "registration_hash", "evaluation_specification_id", "evaluation_specification_hash", "case_alias", "event_archetype", "market_snapshot_id", "market_snapshot_hash", "sealed_at", "sealed_before_agent_runs", "seal_status", "expected_judgments", "outcome_payload", "execution_capability"],
  "properties": {
    "schema_version": {"const": "market-impact.method-quality-outcome-seal.v1"},
    "seal_id": {"type": "string", "pattern": "^method-quality-outcome-seal-[0-9a-f]{64}$"},
    "registration_id": {"type": "string", "pattern": "^method-quality-benchmark-[0-9a-f]{64}$"},
    "registration_hash": {"$ref": "#/$defs/sha256"},
    "evaluation_specification_id": {"type": "string", "pattern": "^method-quality-evaluation-[0-9a-f]{64}$"},
    "evaluation_specification_hash": {"$ref": "#/$defs/sha256"},
    "case_alias": {"$ref": "#/$defs/identifier"},
    "event_archetype": {"enum": ["issuer_corporate", "macro_real_economy", "policy_regulatory", "geopolitical_security", "physical_supply_logistics", "climate_natural_hazard", "technology_demand_adoption", "financial_market_mechanics"]},
    "market_snapshot_id": {"type": "string", "pattern": "^method-quality-market-snapshot-[0-9a-f]{64}$"},
    "market_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "sealed_before_agent_runs": {"const": true}, "seal_status": {"const": "sealed"},
    "expected_judgments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expected_judgment"}},
    "outcome_payload": {"type": "null"}, "execution_capability": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "expected_judgment": {"type": "object", "additionalProperties": false, "required": ["case_alias", "replicate", "arm", "run_id", "evidence_pack_id"], "properties": {"case_alias": {"$ref": "#/$defs/identifier"}, "replicate": {"type": "integer", "minimum": 1}, "arm": {"enum": ["neutral_evidence", "general_methods", "general_pattern", "family_guided"]}, "run_id": {"type": "string", "minLength": 1}, "evidence_pack_id": {"type": "string", "pattern": "^evidence-pack-[0-9a-f]{64}$"}}}
  }
}

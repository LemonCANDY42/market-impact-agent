{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/strategy-validation-report-v2.schema.json",
  "title": "Strategy Validation Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "harness_authority_id", "registration_id", "registration_hash", "run_set_seal_hash", "prospective_window_seal_hash", "disposition", "evidence_lane", "independent_case_count", "nonempty_execution_count", "outcomes_hash", "portfolio_metrics_hash", "reasons", "execution_capability"],
  "properties": {
    "schema_version": {"const": "market-impact.strategy-validation-report.v2"},
    "report_id": {"type": "string", "pattern": "^strategy-validation-report-[0-9a-f]{64}$"},
    "harness_authority_id": {"type": "string", "pattern": "^harness-authority-[0-9a-f]{32}$"},
    "registration_id": {"type": "string", "pattern": "^strategy-validation-registration-[0-9a-f]{64}$"},
    "registration_hash": {"$ref": "#/$defs/sha256"}, "run_set_seal_hash": {"$ref": "#/$defs/sha256"},
    "prospective_window_seal_hash": {"$ref": "#/$defs/nullable_sha256"},
    "disposition": {"enum": ["accepted", "rejected", "inconclusive"]},
    "evidence_lane": {"enum": ["strict_pit", "prospective_actual_receipt"]},
    "independent_case_count": {"type": "integer", "minimum": 0}, "nonempty_execution_count": {"type": "integer", "minimum": 0},
    "outcomes_hash": {"$ref": "#/$defs/sha256"}, "portfolio_metrics_hash": {"$ref": "#/$defs/nullable_sha256"},
    "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_capability": {"const": "none"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "nullable_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/portfolio-decision-v2.schema.json",
  "title": "Market Impact Portfolio Decision v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "proposal", "authorized_decision_view_id",
    "authorized_decision_view_hash", "position_snapshot_id", "position_snapshot_hash",
    "bearish_expression_binding", "legs", "outcome", "blockers", "decided_at",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.portfolio-decision.v2"},
    "decision_id": {"type": "string", "pattern": "^portfolio-decision-v2-[0-9a-f]{64}$"},
    "proposal": {"$ref": "agent-portfolio-proposal-v2.schema.json"},
    "authorized_decision_view_id": {"type": "string", "pattern": "^authorized-decision-view-[0-9a-f]{64}$"},
    "authorized_decision_view_hash": {"$ref": "#/$defs/sha256"},
    "position_snapshot_id": {"type": "string", "pattern": "^position-snapshot-[0-9a-f]{64}$"},
    "position_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "bearish_expression_binding": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/bearish_binding"}]},
    "legs": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/leg"}},
    "outcome": {"enum": ["no_action", "rejected", "ready_for_sizing"]},
    "blockers": {"$ref": "#/$defs/strings"},
    "decided_at": {"type": "string", "format": "date-time"},
    "execution_capability": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "nonnegative_decimal": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "bearish_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "binding_id", "proposal_id", "account_reference_hash", "instrument_id", "mode", "account_permission_confirmed", "shortable_quantity", "allowlisted_inverse_etf", "leverage_magnitude", "evidence_refs", "observed_at", "valid_until"],
      "properties": {
        "schema_version": {"const": "market-impact.bearish-expression-binding.v1"},
        "binding_id": {"type": "string", "pattern": "^bearish-expression-binding-[0-9a-f]{64}$"},
        "proposal_id": {"type": "string", "pattern": "^agent-portfolio-proposal-[0-9a-f]{64}$"},
        "account_reference_hash": {"type": "string", "pattern": "^account-ref-[0-9a-f]{64}$"},
        "instrument_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["borrowed_ordinary_etf", "nonlevered_inverse_etf"]},
        "account_permission_confirmed": {"type": "boolean"},
        "shortable_quantity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_decimal"}]},
        "allowlisted_inverse_etf": {"type": "boolean"},
        "leverage_magnitude": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_decimal"}]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"}
      }
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "action", "instrument_id", "venue", "instrument_class", "direction", "target_gross_exposure_ratio", "current_side", "current_quantity", "current_concentration", "current_concentration_gap", "position_snapshot_position_hash", "physical_target_side", "gate"],
      "properties": {
        "role": {"enum": ["primary", "rotation_source", "rotation_destination"]},
        "action": {"enum": ["hold", "open", "increase", "reduce", "close"]},
        "instrument_id": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1},
        "instrument_class": {"enum": ["equity", "exchange_traded_fund"]},
        "direction": {"enum": ["long", "short"]},
        "target_gross_exposure_ratio": {"$ref": "#/$defs/nonnegative_decimal"},
        "current_side": {"oneOf": [{"type": "null"}, {"enum": ["buy", "sell"]}]},
        "current_quantity": {"$ref": "#/$defs/nonnegative_decimal"},
        "current_concentration": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_decimal"}]},
        "current_concentration_gap": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "position_snapshot_position_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "physical_target_side": {"enum": ["buy", "sell"]},
        "gate": {"oneOf": [{"type": "null"}, {"const": "blocked_pending_source_reconciliation"}]}
      }
    }
  }
}

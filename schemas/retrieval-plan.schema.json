{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/retrieval-plan.schema.json",
  "title": "Market Impact Retrieval Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "scope_id", "query_template_ref", "template_matcher_contract_hash", "collection_policy_id", "capability", "pit_lane", "sources", "cadence_seconds", "maximum_gap_seconds", "freshness_max_age_seconds", "minimum_coverage_sources", "maximum_fetches", "maximum_bytes"],
  "properties": {
    "schema_version": {"const": "market-impact.retrieval-plan.v1"},
    "plan_id": {"type": "string", "pattern": "^retrieval-plan-[0-9a-f]{64}$"},
    "scope_id": {"type": "string", "pattern": "^monitoring-scope-[0-9a-f]{64}$"},
    "query_template_ref": {"type": "string", "pattern": "^monitoring-query-template-[0-9a-f]{64}$"},
    "template_matcher_contract_hash": {"$ref": "#/$defs/sha256"},
    "collection_policy_id": {"type": "string", "pattern": "^prospective-collection-policy-[0-9a-f]{64}$"},
    "capability": {"$ref": "#/$defs/capability"},
    "pit_lane": {"enum": ["strict", "modeled", "prospective", "retrospective"]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "cadence_seconds": {"type": "integer", "minimum": 1},
    "maximum_gap_seconds": {"type": "integer", "minimum": 1},
    "freshness_max_age_seconds": {"type": "integer", "minimum": 0},
    "minimum_coverage_sources": {"type": "integer", "minimum": 1},
    "maximum_fetches": {"type": "integer", "minimum": 0},
    "maximum_bytes": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_version", "upstream_source", "manifest_hash", "source_config_hash", "required"], "properties": {"provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "provider_version": {"type": "string", "minLength": 1}, "upstream_source": {"type": "string", "minLength": 1}, "manifest_hash": {"$ref": "#/$defs/sha256"}, "source_config_hash": {"$ref": "#/$defs/sha256"}, "required": {"type": "boolean"}}},
    "capability": {"enum": ["event_revelation", "prior_expectation", "market_context", "exposure_candidates", "positioning", "macro_vintage", "prediction_market_discovery", "prediction_market_snapshot", "prediction_market_history"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/portfolio-decision.schema.json",
  "title": "Market Impact Portfolio Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision_id", "signal_id", "signal_hash",
    "authorized_decision_view_id", "authorized_decision_view_hash",
    "position_snapshot_id", "position_snapshot_hash", "requested_action",
    "instrument_id", "venue", "instrument_class", "evidence_refs", "outcome",
    "order_side", "current_position_quantity", "blockers", "decided_at",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.portfolio-decision.v1"},
    "decision_id": {"type": "string", "pattern": "^portfolio-decision-[0-9a-f]{64}$"},
    "signal_id": {"type": "string", "minLength": 1},
    "signal_hash": {"$ref": "#/$defs/sha256"},
    "authorized_decision_view_id": {"type": "string", "pattern": "^authorized-decision-view-[0-9a-f]{64}$"},
    "authorized_decision_view_hash": {"$ref": "#/$defs/sha256"},
    "position_snapshot_id": {"type": "string", "pattern": "^position-snapshot-[0-9a-f]{64}$"},
    "position_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "requested_action": {"enum": ["abstain", "observe", "hold", "open", "increase", "reduce", "close", "rotate"]},
    "instrument_id": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "instrument_class": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "outcome": {"enum": ["no_action", "rejected", "ready_for_sizing"]},
    "order_side": {"oneOf": [{"type": "null"}, {"enum": ["buy", "sell"]}]},
    "current_position_quantity": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/positive_decimal"}]},
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "decided_at": {"type": "string", "format": "date-time"},
    "execution_capability": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positive_decimal": {"type": "string", "pattern": "^(?:0*[1-9][0-9]*|0*[0-9]*\\.[0-9]*[1-9][0-9]*)$"}
  }
}

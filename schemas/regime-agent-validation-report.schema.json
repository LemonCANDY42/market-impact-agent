{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-impact-agent.local/schemas/regime-agent-validation-report.schema.json",
  "title": "Regime Agent Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "validation_id",
    "dataset_id",
    "study_registration_id",
    "panel_id",
    "manifest_id",
    "qualification_report_id",
    "provider_profile_id",
    "case_count",
    "checkpoint_count",
    "formal_run_count",
    "cases",
    "aggregate",
    "cost",
    "limitations",
    "inference_eligible",
    "broker_reachability",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.regime-agent-validation-report.v1"},
    "report_id": {
      "type": "string",
      "pattern": "^regime-agent-validation-report-[0-9a-f]{64}$"
    },
    "validation_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "study_registration_id": {"type": "string", "minLength": 1},
    "panel_id": {"type": "string", "pattern": "^regime-panel-[0-9a-f]{64}$"},
    "manifest_id": {
      "type": "string",
      "pattern": "^regime-evidence-manifest-[0-9a-f]{64}$"
    },
    "qualification_report_id": {
      "type": "string",
      "pattern": "^regime-evidence-qualification-report-[0-9a-f]{64}$"
    },
    "provider_profile_id": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 2},
    "checkpoint_count": {"type": "integer", "minimum": 6},
    "formal_run_count": {"type": "integer", "minimum": 36},
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/case_result"}
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "cost": {"$ref": "#/$defs/cost"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "inference_eligible": {"const": false},
    "broker_reachability": {"const": false},
    "execution_capability": {"const": "none"}
  },
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{8}$"},
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_key",
        "treatment_skill",
        "checkpoints",
        "case_report_id",
        "control_total_return",
        "routed_skill_total_return",
        "primary_baseline_total_return",
        "equal_sector_baseline_total_return",
        "lagged_sector_momentum_total_return",
        "control_directional_hit_count",
        "routed_skill_directional_hit_count",
        "formal_model_cost_microusd"
      ],
      "properties": {
        "case_key": {"type": "string", "minLength": 1},
        "treatment_skill": {"type": "string", "minLength": 1},
        "checkpoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        },
        "case_report_id": {"type": "string", "minLength": 1},
        "control_total_return": {"$ref": "#/$defs/decimal"},
        "routed_skill_total_return": {"$ref": "#/$defs/decimal"},
        "primary_baseline_total_return": {"$ref": "#/$defs/decimal"},
        "equal_sector_baseline_total_return": {"$ref": "#/$defs/decimal"},
        "lagged_sector_momentum_total_return": {"$ref": "#/$defs/decimal"},
        "control_directional_hit_count": {"type": "integer", "minimum": 0},
        "routed_skill_directional_hit_count": {"type": "integer", "minimum": 0},
        "formal_model_cost_microusd": {"type": "integer", "minimum": 0}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_directional_hit_count",
        "routed_skill_directional_hit_count",
        "checkpoint_count",
        "control_directional_hit_rate",
        "routed_skill_directional_hit_rate",
        "control_mean_case_return",
        "routed_skill_mean_case_return",
        "primary_baseline_mean_case_return",
        "equal_sector_baseline_mean_case_return",
        "lagged_sector_momentum_mean_case_return",
        "routed_skill_case_win_count_vs_control",
        "routed_skill_case_win_count_vs_primary",
        "routed_skill_case_win_count_vs_equal_sector",
        "routed_skill_case_win_count_vs_lagged_sector_momentum",
        "helpful_checkpoint_count",
        "harmful_checkpoint_count",
        "same_decision_checkpoint_count",
        "control_worst_case_return",
        "routed_skill_worst_case_return",
        "control_worst_case_max_drawdown",
        "routed_skill_worst_case_max_drawdown"
      ],
      "properties": {
        "control_directional_hit_count": {"type": "integer", "minimum": 0},
        "routed_skill_directional_hit_count": {"type": "integer", "minimum": 0},
        "checkpoint_count": {"type": "integer", "minimum": 1},
        "control_directional_hit_rate": {"$ref": "#/$defs/decimal"},
        "routed_skill_directional_hit_rate": {"$ref": "#/$defs/decimal"},
        "control_mean_case_return": {"$ref": "#/$defs/decimal"},
        "routed_skill_mean_case_return": {"$ref": "#/$defs/decimal"},
        "primary_baseline_mean_case_return": {"$ref": "#/$defs/decimal"},
        "equal_sector_baseline_mean_case_return": {"$ref": "#/$defs/decimal"},
        "lagged_sector_momentum_mean_case_return": {"$ref": "#/$defs/decimal"},
        "routed_skill_case_win_count_vs_control": {"type": "integer", "minimum": 0},
        "routed_skill_case_win_count_vs_primary": {"type": "integer", "minimum": 0},
        "routed_skill_case_win_count_vs_equal_sector": {
          "type": "integer",
          "minimum": 0
        },
        "routed_skill_case_win_count_vs_lagged_sector_momentum": {
          "type": "integer",
          "minimum": 0
        },
        "helpful_checkpoint_count": {"type": "integer", "minimum": 0},
        "harmful_checkpoint_count": {"type": "integer", "minimum": 0},
        "same_decision_checkpoint_count": {"type": "integer", "minimum": 0},
        "control_worst_case_return": {"$ref": "#/$defs/decimal"},
        "routed_skill_worst_case_return": {"$ref": "#/$defs/decimal"},
        "control_worst_case_max_drawdown": {"$ref": "#/$defs/decimal"},
        "routed_skill_worst_case_max_drawdown": {"$ref": "#/$defs/decimal"}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_model_cost_microusd",
        "prior_invalid_or_superseded_diagnostic_cost_microusd",
        "all_actual_model_cost_microusd",
        "hard_cap_microusd",
        "within_budget"
      ],
      "properties": {
        "formal_model_cost_microusd": {"type": "integer", "minimum": 0},
        "prior_invalid_or_superseded_diagnostic_cost_microusd": {
          "type": "integer",
          "minimum": 0
        },
        "all_actual_model_cost_microusd": {"type": "integer", "minimum": 0},
        "hard_cap_microusd": {"type": "integer", "minimum": 1, "maximum": 20000000},
        "within_budget": {"const": true}
      }
    }
  }
}

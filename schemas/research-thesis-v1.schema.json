{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/research-thesis-v1.schema.json",
  "title": "Dynamic-horizon research thesis v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "thesis_id", "root_event_id", "thesis_epoch", "as_of",
    "horizon_band", "primary_horizon_sessions", "base_case_direction", "thesis",
    "priced_in_assessment", "transmission", "counter_scenario", "evidence_refs",
    "counterevidence_refs", "invalidation_conditions", "review_after_sessions",
    "typed_unknowns"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.research-thesis.v1"},
    "thesis_id": {"type": "string", "pattern": "^research-thesis-v1-[0-9a-f]{64}$"},
    "root_event_id": {"type": "string", "minLength": 1},
    "thesis_epoch": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date-time"},
    "horizon_band": {"enum": ["immediate", "tactical", "swing"]},
    "primary_horizon_sessions": {"enum": [1, 3, 5, 10, 20, 60]},
    "base_case_direction": {"enum": ["up", "down", "rangebound"]},
    "thesis": {"type": "string", "minLength": 1},
    "priced_in_assessment": {"type": "string", "minLength": 1},
    "transmission": {"$ref": "#/$defs/nonempty_strings"},
    "counter_scenario": {"type": "string", "minLength": 1},
    "evidence_refs": {"$ref": "#/$defs/nonempty_strings"},
    "counterevidence_refs": {"$ref": "#/$defs/strings"},
    "invalidation_conditions": {"$ref": "#/$defs/nonempty_strings"},
    "review_after_sessions": {"type": "integer", "minimum": 1, "maximum": 60},
    "typed_unknowns": {"$ref": "#/$defs/strings"}
  },
  "allOf": [
    {
      "if": {"properties": {"horizon_band": {"const": "immediate"}}},
      "then": {"properties": {"primary_horizon_sessions": {"enum": [1, 3]}}}
    },
    {
      "if": {"properties": {"horizon_band": {"const": "tactical"}}},
      "then": {"properties": {"primary_horizon_sessions": {"enum": [5, 10]}}}
    },
    {
      "if": {"properties": {"horizon_band": {"const": "swing"}}},
      "then": {"properties": {"primary_horizon_sessions": {"enum": [20, 60]}}}
    }
  ],
  "$defs": {
    "strings": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonempty_strings": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-impact-agent.local/schemas/regime-modeled-pit-policy.schema.json",
  "title": "Market Regime Modeled PIT Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "description",
    "category_rules",
    "authority_treatment",
    "latency_assumptions_calibrated",
    "inference_eligible",
    "broker_reachability",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.regime-modeled-pit-policy.v1"},
    "policy_id": {
      "type": "string",
      "pattern": "^regime-modeled-pit-policy-[0-9a-f]{64}$"
    },
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category_rules": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/category_rule"}
    },
    "authority_treatment": {
      "const": "reported_as_gap_not_required_for_exploratory_replay"
    },
    "latency_assumptions_calibrated": {"const": false},
    "inference_eligible": {"const": false},
    "broker_reachability": {"const": false},
    "execution_capability": {"const": "none"}
  },
  "$defs": {
    "category_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "visibility_basis",
        "allowed_availability_bases",
        "safety_delay_seconds"
      ],
      "properties": {
        "category": {
          "enum": [
            "market_price",
            "industry_price",
            "official_context",
            "macro_vintage",
            "established_news",
            "positioning_or_expectations",
            "issuer_or_sector_fundamentals"
          ]
        },
        "visibility_basis": {
          "enum": ["prior_session_panel_snapshot", "record_available_at_plus_safety_delay"]
        },
        "allowed_availability_bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["actual_receipt", "source_reported", "modeled_latency"]}
        },
        "safety_delay_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    }
  }
}

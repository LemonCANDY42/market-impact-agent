{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/method-quality-market-snapshot.schema.json",
  "title": "Method Quality Market Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_id", "case_alias", "case_cutoff_session", "case_as_of", "evaluation_specification_id", "evaluation_specification_hash", "created_at", "sealed_before_agent_runs", "source_vintage_id", "source_vintage_hash", "venue", "timezone", "currency", "calendar_id", "calendar_sessions", "corporate_actions", "instrument_prices", "benchmark_id", "benchmark_prices", "fee_schedule", "venue_rules", "execution_capability"],
  "properties": {
    "schema_version": {"const": "market-impact.method-quality-market-snapshot.v1"},
    "snapshot_id": {"type": "string", "pattern": "^method-quality-market-snapshot-[0-9a-f]{64}$"},
    "case_alias": {"$ref": "#/$defs/identifier"},
    "case_cutoff_session": {"type": "string", "format": "date"},
    "case_as_of": {"type": "string", "format": "date-time"},
    "evaluation_specification_id": {"type": "string", "pattern": "^method-quality-evaluation-[0-9a-f]{64}$"},
    "evaluation_specification_hash": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "sealed_before_agent_runs": {"const": true},
    "source_vintage_id": {"type": "string", "pattern": "^source-vintage-[0-9a-f]{64}$"},
    "source_vintage_hash": {"$ref": "#/$defs/sha256"},
    "venue": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "calendar_id": {"type": "string", "minLength": 1},
    "calendar_sessions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "format": "date"}},
    "corporate_actions": {"type": "array", "items": {"$ref": "#/$defs/corporate_action"}},
    "instrument_prices": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/instrument_price"}},
    "benchmark_id": {"type": "string", "minLength": 1},
    "benchmark_prices": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/benchmark_price"}},
    "fee_schedule": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fee"}},
    "venue_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/venue_rule"}},
    "execution_capability": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "positive_decimal": {"type": "string", "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$"},
    "nullable_date": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
    "nullable_positive_decimal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/positive_decimal"}]},
    "price_base": {
      "type": "object",
      "required": ["session_date", "open", "high", "low", "close", "volume", "adjustment_factor", "trade_status", "limit_up", "limit_down", "source_version_id"],
      "properties": {
        "session_date": {"type": "string", "format": "date"}, "open": {"$ref": "#/$defs/positive_decimal"}, "high": {"$ref": "#/$defs/positive_decimal"}, "low": {"$ref": "#/$defs/positive_decimal"}, "close": {"$ref": "#/$defs/positive_decimal"}, "volume": {"$ref": "#/$defs/decimal"}, "adjustment_factor": {"$ref": "#/$defs/positive_decimal"}, "trade_status": {"enum": ["open", "suspended", "missing"]}, "limit_up": {"$ref": "#/$defs/nullable_positive_decimal"}, "limit_down": {"$ref": "#/$defs/nullable_positive_decimal"}, "source_version_id": {"type": "string", "minLength": 1}
      }
    },
    "instrument_price": {
      "allOf": [
        {"$ref": "#/$defs/price_base"},
        {"type": "object", "required": ["target_id"], "properties": {"target_id": {"type": "string", "minLength": 1}}}
      ],
      "unevaluatedProperties": false
    },
    "benchmark_price": {"allOf": [{"$ref": "#/$defs/price_base"}], "unevaluatedProperties": false},
    "corporate_action": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "effective_session", "action_type", "factor", "source_version_id"],
      "properties": {"target_id": {"type": "string", "minLength": 1}, "effective_session": {"type": "string", "format": "date"}, "action_type": {"type": "string", "minLength": 1}, "factor": {"$ref": "#/$defs/positive_decimal"}, "source_version_id": {"type": "string", "minLength": 1}}
    },
    "fee": {
      "type": "object", "additionalProperties": false,
      "required": ["fee_id", "effective_from", "effective_through", "side", "component", "rate", "minimum_amount", "rounding_quantum", "rounding_mode"],
      "properties": {"fee_id": {"type": "string", "minLength": 1}, "effective_from": {"type": "string", "format": "date"}, "effective_through": {"$ref": "#/$defs/nullable_date"}, "side": {"enum": ["entry", "exit"]}, "component": {"type": "string", "minLength": 1}, "rate": {"$ref": "#/$defs/decimal"}, "minimum_amount": {"$ref": "#/$defs/decimal"}, "rounding_quantum": {"$ref": "#/$defs/positive_decimal"}, "rounding_mode": {"const": "half_up"}}
    },
    "venue_rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "effective_from", "effective_through", "board_lot_size", "price_tick", "price_limit_basis", "suspension_fill_policy", "missing_bar_policy"],
      "properties": {"rule_id": {"type": "string", "minLength": 1}, "effective_from": {"type": "string", "format": "date"}, "effective_through": {"$ref": "#/$defs/nullable_date"}, "board_lot_size": {"type": "integer", "minimum": 1}, "price_tick": {"$ref": "#/$defs/positive_decimal"}, "price_limit_basis": {"const": "snapshot_limits"}, "suspension_fill_policy": {"const": "no_fill"}, "missing_bar_policy": {"const": "missing_zero_value_in_denominator"}}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LemonCANDY42/market-impact-agent/schemas/phase2-calibration-evidence.schema.json",
  "title": "Market Impact Phase 2 Calibration Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runs"],
  "properties": {
    "schema_version": {"const": "market-impact.phase2-calibration-evidence.v1"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_cluster_id", "visible_at", "partition", "variant",
          "first_result", "repeat_result"
        ],
        "properties": {
          "event_cluster_id": {"type": "string", "minLength": 1},
          "visible_at": {"type": "string", "format": "date-time"},
          "partition": {"enum": ["train", "test"]},
          "variant": {
            "enum": ["event_reasoning", "sentiment", "momentum", "fixed_mapping", "simple_hold"]
          },
          "first_result": {
            "type": "string", "minLength": 1,
            "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}
          },
          "repeat_result": {
            "type": "string", "minLength": 1,
            "not": {"pattern": "^(?:/|.*(?:^|/)\\.\\.(?:/|$))"}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/method-quality-outcome-opening.schema.json",
  "title": "Method Quality Outcome Opening",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "opening_id", "seal_id", "seal_hash", "registration_id", "registration_hash", "evaluation_specification_id", "evaluation_specification_hash", "case_alias", "market_snapshot_id", "market_snapshot_hash", "opened_at", "opening_sequence", "prior_opening_id", "seal_status", "judgments", "results", "case_values", "execution_capability"],
  "properties": {
    "schema_version": {"const": "market-impact.method-quality-outcome-opening.v1"},
    "opening_id": {"type": "string", "pattern": "^method-quality-outcome-opening-[0-9a-f]{64}$"},
    "seal_id": {"type": "string", "pattern": "^method-quality-outcome-seal-[0-9a-f]{64}$"}, "seal_hash": {"$ref": "#/$defs/sha256"},
    "registration_id": {"type": "string", "pattern": "^method-quality-benchmark-[0-9a-f]{64}$"}, "registration_hash": {"$ref": "#/$defs/sha256"},
    "evaluation_specification_id": {"type": "string", "pattern": "^method-quality-evaluation-[0-9a-f]{64}$"}, "evaluation_specification_hash": {"$ref": "#/$defs/sha256"},
    "case_alias": {"$ref": "#/$defs/identifier"}, "market_snapshot_id": {"type": "string", "pattern": "^method-quality-market-snapshot-[0-9a-f]{64}$"}, "market_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "opened_at": {"type": "string", "format": "date-time"}, "opening_sequence": {"const": 1}, "prior_opening_id": {"type": "null"}, "seal_status": {"const": "opened"},
    "judgments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/judgment"}},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "case_values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case_value"}},
    "execution_capability": {"const": "none"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"}, "nullable_decimal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]}, "nullable_date": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
    "judgment": {"type": "object", "additionalProperties": false, "required": ["case_alias", "replicate", "arm", "run_id", "evidence_pack_id", "artifact_id", "artifact_hash"], "properties": {"case_alias": {"$ref": "#/$defs/identifier"}, "replicate": {"type": "integer", "minimum": 1}, "arm": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "evidence_pack_id": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "pattern": "^judgment-[0-9a-f]{64}$"}, "artifact_hash": {"$ref": "#/$defs/sha256"}}},
    "cost_component": {"type": "object", "additionalProperties": false, "required": ["fee_id", "side", "component", "reference_value", "amount"], "properties": {"fee_id": {"type": "string", "minLength": 1}, "side": {"enum": ["entry", "exit"]}, "component": {"type": "string", "minLength": 1}, "reference_value": {"$ref": "#/$defs/decimal"}, "amount": {"$ref": "#/$defs/decimal"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["result_id", "case_alias", "replicate", "arm", "artifact_id", "artifact_hash", "target_id", "horizon_sessions", "direction", "fill_status", "entry_session", "entry_price", "quantity", "entry_reference_value", "exit_session", "exit_price", "exit_reference_value", "cost_components", "total_cost_proxy_amount", "price_move_ratio", "directional_score", "cost_proxy", "benchmark_move_ratio", "benchmark_adjusted_directional_score"], "properties": {"result_id": {"type": "string", "pattern": "^method-quality-result-[0-9a-f]{64}$"}, "case_alias": {"$ref": "#/$defs/identifier"}, "replicate": {"type": "integer", "minimum": 1}, "arm": {"type": "string", "minLength": 1}, "artifact_id": {"type": "string", "pattern": "^judgment-[0-9a-f]{64}$"}, "artifact_hash": {"$ref": "#/$defs/sha256"}, "target_id": {"type": "string", "minLength": 1}, "horizon_sessions": {"enum": [1, 3, 10]}, "direction": {"enum": ["up", "down", "mixed", "unknown"]}, "fill_status": {"enum": ["filled", "no_fill", "missing_market_data", "unscored_direction"]}, "entry_session": {"$ref": "#/$defs/nullable_date"}, "entry_price": {"$ref": "#/$defs/nullable_decimal"}, "quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}, "entry_reference_value": {"$ref": "#/$defs/nullable_decimal"}, "exit_session": {"$ref": "#/$defs/nullable_date"}, "exit_price": {"$ref": "#/$defs/nullable_decimal"}, "exit_reference_value": {"$ref": "#/$defs/nullable_decimal"}, "cost_components": {"type": "array", "items": {"$ref": "#/$defs/cost_component"}}, "total_cost_proxy_amount": {"$ref": "#/$defs/decimal"}, "price_move_ratio": {"$ref": "#/$defs/decimal"}, "directional_score": {"$ref": "#/$defs/decimal"}, "cost_proxy": {"$ref": "#/$defs/decimal"}, "benchmark_move_ratio": {"$ref": "#/$defs/decimal"}, "benchmark_adjusted_directional_score": {"$ref": "#/$defs/decimal"}}},
    "case_value": {"type": "object", "additionalProperties": false, "required": ["case_alias", "replicate", "arm", "status", "component_result_ids", "value"], "properties": {"case_alias": {"$ref": "#/$defs/identifier"}, "replicate": {"type": "integer", "minimum": 1}, "arm": {"type": "string", "minLength": 1}, "status": {"enum": ["valued", "abstain", "no_fill", "unknown_or_mixed", "missing"]}, "component_result_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^method-quality-result-[0-9a-f]{64}$"}}, "value": {"$ref": "#/$defs/decimal"}}}
  }
}

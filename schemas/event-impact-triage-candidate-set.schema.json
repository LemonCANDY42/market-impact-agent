{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/event-impact-triage-candidate-set.schema.json",
  "title": "Market Impact Event Impact Triage Candidate Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_set_id",
    "registration_id",
    "checkpoint_key",
    "route_plan_id",
    "route_admission_id",
    "readiness_report_id",
    "data_snapshot_id",
    "admitted_at",
    "frozen_at",
    "observations",
    "historical_pit_claim",
    "judgment_model_calls_authorized",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.event-impact-triage-candidate-set.v1"},
    "candidate_set_id": {
      "type": "string",
      "pattern": "^event-impact-triage-candidate-set-[0-9a-f]{64}$"
    },
    "registration_id": {
      "type": "string",
      "pattern": "^prospective-diagnostic-registration-[0-9a-f]{64}$"
    },
    "checkpoint_key": {"type": "string", "minLength": 1},
    "route_plan_id": {
      "type": "string",
      "pattern": "^prospective-checkpoint-route-plan-[0-9a-f]{64}$"
    },
    "route_admission_id": {
      "type": "string",
      "pattern": "^prospective-checkpoint-route-admission-[0-9a-f]{64}$"
    },
    "readiness_report_id": {
      "type": "string",
      "pattern": "^prospective-checkpoint-readiness-report-[0-9a-f]{64}$"
    },
    "data_snapshot_id": {
      "type": "string",
      "pattern": "^data-snapshot-[0-9a-f]{64}$"
    },
    "admitted_at": {"type": "string", "format": "date-time"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observation"}
    },
    "historical_pit_claim": {"const": false},
    "judgment_model_calls_authorized": {"const": false},
    "execution_capability": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "observation_id",
        "first_available_at",
        "authority_at",
        "provider_id",
        "provider_version",
        "upstream_source",
        "source_ref",
        "raw_content_hash",
        "normalized_payload_hash"
      ],
      "properties": {
        "version_id": {
          "type": "string",
          "pattern": "^prospective-observation-version-[0-9a-f]{64}$"
        },
        "observation_id": {
          "type": "string",
          "pattern": "^source-observation-[0-9a-f]{64}$"
        },
        "first_available_at": {"type": "string", "format": "date-time"},
        "authority_at": {"type": "string", "format": "date-time"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "upstream_source": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "raw_content_hash": {"$ref": "#/$defs/sha256"},
        "normalized_payload_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

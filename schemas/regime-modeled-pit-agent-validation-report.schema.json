{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-impact-agent.local/schemas/regime-modeled-pit-agent-validation-report.schema.json",
  "title": "Modeled PIT Regime Agent Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "validation_id",
    "dataset_id",
    "panel_id",
    "manifest_id",
    "strict_qualification_report_id",
    "modeled_qualification_report_id",
    "policy_id",
    "provider_profile_id",
    "case_count",
    "checkpoint_count",
    "completed_checkpoint_count",
    "formal_run_count",
    "case_results",
    "decision_summary",
    "cost",
    "limitations",
    "claim_scope",
    "strict_pit_eligible",
    "agent_effectiveness_claim_eligible",
    "inference_eligible",
    "broker_reachability",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {
      "const": "market-impact.regime-modeled-pit-agent-validation-report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^regime-modeled-pit-agent-validation-report-[0-9a-f]{64}$"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^regime-modeled-pit-agent-validation-[0-9a-f]{64}$"
    },
    "dataset_id": {"type": "string", "minLength": 1},
    "panel_id": {"type": "string", "minLength": 1},
    "manifest_id": {"type": "string", "minLength": 1},
    "strict_qualification_report_id": {"type": "string", "minLength": 1},
    "modeled_qualification_report_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "provider_profile_id": {"type": "string", "minLength": 1},
    "case_count": {"type": "integer", "minimum": 1},
    "checkpoint_count": {"type": "integer", "minimum": 1},
    "completed_checkpoint_count": {"type": "integer", "minimum": 1},
    "formal_run_count": {"type": "integer", "minimum": 6},
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case_result"}
    },
    "decision_summary": {"$ref": "#/$defs/decision_summary"},
    "cost": {"$ref": "#/$defs/cost"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_scope": {"const": "opened_modeled_pit_process_diagnostic_only"},
    "strict_pit_eligible": {"const": false},
    "agent_effectiveness_claim_eligible": {"const": false},
    "inference_eligible": {"const": false},
    "broker_reachability": {"const": false},
    "execution_capability": {"const": "none"}
  },
  "$defs": {
    "checkpoint_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_date",
        "cutoff_at",
        "eligible_horizon_sessions",
        "eligible_open_to_close_return",
        "evidence_pack_id",
        "paired_registration_id",
        "paired_registration_hash",
        "common_input_hash",
        "paired_report_id",
        "execution_bindings",
        "actual_model_cost_microusd",
        "arms",
        "incremental_skill_effect"
      ],
      "properties": {
        "session_date": {"type": "string", "format": "date"},
        "cutoff_at": {"type": "string", "format": "date-time"},
        "eligible_horizon_sessions": {"type": "integer", "minimum": 1},
        "eligible_open_to_close_return": {
          "$ref": "https://market-impact-agent.local/schemas/regime-agent-experiment-report.schema.json#/$defs/decimal"
        },
        "evidence_pack_id": {"type": "string", "minLength": 1},
        "paired_registration_id": {
          "type": "string",
          "pattern": "^method-skill-ablation-[0-9a-f]{64}$"
        },
        "paired_registration_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "common_input_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "paired_report_id": {"type": "string", "minLength": 1},
        "execution_bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arm_id", "binding_hash"],
            "properties": {
              "arm_id": {"type": "string", "minLength": 1},
              "binding_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "actual_model_cost_microusd": {"type": "integer", "minimum": 0},
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "https://market-impact-agent.local/schemas/regime-agent-experiment-report.schema.json#/$defs/arm_aggregate"
          }
        },
        "incremental_skill_effect": {
          "enum": ["helpful", "harmful", "same_decision"]
        }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_key",
        "treatment_skill",
        "evidence_pack_ids",
        "checkpoint_count",
        "formal_run_count",
        "checkpoint_results",
        "arms",
        "baselines",
        "market_context",
        "skill_increment",
        "formal_model_cost_microusd"
      ],
      "properties": {
        "case_key": {"type": "string", "minLength": 1},
        "treatment_skill": {"type": "string", "minLength": 1},
        "evidence_pack_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checkpoint_count": {"type": "integer", "minimum": 1},
        "formal_run_count": {"type": "integer", "minimum": 6},
        "checkpoint_results": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkpoint_result"}
        },
        "arms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "https://market-impact-agent.local/schemas/regime-agent-experiment-report.schema.json#/$defs/arm_summary"
          }
        },
        "baselines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "https://market-impact-agent.local/schemas/regime-agent-experiment-report.schema.json#/$defs/baseline"
          }
        },
        "market_context": {
          "$ref": "https://market-impact-agent.local/schemas/regime-agent-experiment-report.schema.json#/$defs/market_context"
        },
        "skill_increment": {
          "$ref": "https://market-impact-agent.local/schemas/regime-agent-experiment-report.schema.json#/$defs/skill_increment"
        },
        "formal_model_cost_microusd": {"type": "integer", "minimum": 0}
      }
    },
    "decision_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_propose_checkpoint_count",
        "treatment_propose_checkpoint_count",
        "helpful_checkpoint_count",
        "harmful_checkpoint_count",
        "same_decision_checkpoint_count"
      ],
      "properties": {
        "control_propose_checkpoint_count": {"type": "integer", "minimum": 0},
        "treatment_propose_checkpoint_count": {"type": "integer", "minimum": 0},
        "helpful_checkpoint_count": {"type": "integer", "minimum": 0},
        "harmful_checkpoint_count": {"type": "integer", "minimum": 0},
        "same_decision_checkpoint_count": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_ledger_count",
        "usage_unique_run_count",
        "usage_duplicate_record_count",
        "usage_completed_run_count",
        "usage_failed_run_count",
        "usage_union_hash",
        "invalid_horizon_experiment_id",
        "preexisting_actual_diagnostic_cost_microusd",
        "invalid_horizon_diagnostic_cost_microusd",
        "formal_modeled_pit_cost_microusd",
        "all_actual_model_cost_microusd",
        "hard_cap_microusd",
        "within_budget"
      ],
      "properties": {
        "usage_ledger_count": {"type": "integer", "minimum": 1},
        "usage_unique_run_count": {"type": "integer", "minimum": 1},
        "usage_duplicate_record_count": {"type": "integer", "minimum": 0},
        "usage_completed_run_count": {"type": "integer", "minimum": 0},
        "usage_failed_run_count": {"type": "integer", "minimum": 0},
        "usage_union_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "invalid_horizon_experiment_id": {
          "type": "string",
          "pattern": "^regime-modeled-pit-v1b\\."
        },
        "preexisting_actual_diagnostic_cost_microusd": {"type": "integer", "minimum": 0},
        "invalid_horizon_diagnostic_cost_microusd": {"type": "integer", "minimum": 0},
        "formal_modeled_pit_cost_microusd": {"type": "integer", "minimum": 0},
        "all_actual_model_cost_microusd": {"type": "integer", "minimum": 0},
        "hard_cap_microusd": {"type": "integer", "minimum": 1},
        "within_budget": {"type": "boolean"}
      }
    }
  }
}

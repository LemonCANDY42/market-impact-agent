{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/prospective-historical-analogy-pack.schema.json",
  "title": "Market Impact Prospective Historical Analogy Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "cases", "built_at"],
  "properties": {
    "schema_version": {
      "const": "market-impact.prospective-historical-analogy-pack.v1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^prospective-historical-analogy-pack-[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_ref",
          "mode",
          "artifact_hash",
          "similarity_basis",
          "counterevidence"
        ],
        "properties": {
          "case_ref": {"type": "string", "minLength": 1},
          "mode": {
            "enum": ["strict_pit", "modeled_pit", "outcome_opened_review"]
          },
          "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "similarity_basis": {"type": "string", "minLength": 1},
          "counterevidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "built_at": {"type": "string", "format": "date-time"}
  }
}

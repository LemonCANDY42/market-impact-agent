{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/checkpoint-disposition.schema.json",
  "title": "Market Impact Non-run Checkpoint Disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "disposition_id", "kind", "reason", "registration_id",
    "checkpoint_key", "route_plan_id", "route_admission_id", "anchor_candidate_set_id",
    "candidate_decision_ids", "recorded_at", "proven_deadline",
    "judgment_model_calls_authorized", "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.checkpoint-disposition.v1"},
    "disposition_id": {"type": "string", "pattern": "^checkpoint-disposition-[0-9a-f]{64}$"},
    "kind": {"const": "missed_window"},
    "reason": {"const": "legacy_session_unanchored"},
    "registration_id": {"type": "string", "pattern": "^prospective-diagnostic-registration-[0-9a-f]{64}$"},
    "checkpoint_key": {"type": "string", "minLength": 1},
    "route_plan_id": {"type": "string", "pattern": "^prospective-checkpoint-route-plan-[0-9a-f]{64}$"},
    "route_admission_id": {"type": "string", "pattern": "^prospective-checkpoint-route-admission-[0-9a-f]{64}$"},
    "anchor_candidate_set_id": {"type": "string", "pattern": "^event-impact-triage-candidate-set-[0-9a-f]{64}$"},
    "candidate_decision_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_set_id", "triage_decision_id"],
        "properties": {
          "candidate_set_id": {"type": "string", "pattern": "^event-impact-triage-candidate-set-[0-9a-f]{64}$"},
          "triage_decision_id": {"type": "string", "pattern": "^event-impact-triage-decision-[0-9a-f]{64}$"}
        }
      }
    },
    "recorded_at": {"type": "string", "format": "date-time"},
    "proven_deadline": {"const": null},
    "judgment_model_calls_authorized": {"const": false},
    "execution_capability": {"const": false}
  }
}

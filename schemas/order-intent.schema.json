{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LemonCANDY42/market-impact-agent/schemas/order-intent.schema.json",
  "title": "Market Impact Order Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "client_order_id",
    "signal_id",
    "account_id",
    "environment",
    "instrument_id",
    "side",
    "quantity",
    "order_kind",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "market-impact.order-intent.v1"
    },
    "client_order_id": {
      "type": "string",
      "minLength": 1
    },
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "account_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "enum": ["backtest", "paper", "live"]
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "enum": ["buy", "sell"]
    },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "order_kind": {
      "enum": ["market", "limit"]
    },
    "limit_price": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "order_kind": {
            "const": "limit"
          }
        }
      },
      "then": {
        "required": ["limit_price"],
        "properties": {
          "limit_price": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order_kind": {
            "const": "market"
          }
        }
      },
      "then": {
        "properties": {
          "limit_price": {
            "type": "null"
          }
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/agent-watch-request.schema.json",
  "title": "Agent Watch Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "delegate_profile_id", "rationale", "watch_question", "evidence_refs", "subject", "matcher"],
  "properties": {
    "schema_version": {"const": "market-impact.agent-watch-request.v1"},
    "request_id": {"type": "string", "pattern": "^agent-watch-request-[0-9a-f]{64}$"},
    "delegate_profile_id": {"type": "string", "pattern": "^watch-delegate-profile-[0-9a-f]{64}$"},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "watch_question": {"type": "string", "minLength": 1, "maxLength": 1000},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonical_ref"}},
    "subject": {"$ref": "#/$defs/subject"},
    "frozen_members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/subject"}},
    "information_aspect_ref": {"type": "string", "pattern": "^information-aspect-[0-9a-f]{64}$"},
    "matcher": {"$ref": "#/$defs/matcher"}
  },
  "allOf": [
    {
      "if": {"properties": {"subject": {"properties": {"kind": {"const": "frozen_set"}}}}},
      "then": {"required": ["frozen_members"]},
      "else": {"not": {"required": ["frozen_members"]}}
    },
    {
      "if": {"properties": {"subject": {"properties": {"kind": {"const": "information_aspect"}}}}},
      "then": {"required": ["information_aspect_ref"]}
    }
  ],
  "$defs": {
    "canonical_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,127}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonical_id"],
      "properties": {
        "kind": {"enum": ["event_cluster", "industry", "issuer", "instrument", "etf", "frozen_set", "information_aspect"]},
        "canonical_id": {"$ref": "#/$defs/canonical_ref"}
      }
    },
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "mode", "terms"],
      "properties": {
        "field_path": {"enum": ["event_cluster_ids", "industry_codes", "issuer_ids", "instrument_ids", "etf_ids", "subject_refs", "information_aspects", "tags", "headline", "title", "content", "channels", "ts_code", "record.title", "record.headline", "record.content", "record.channels", "record.ts_code"]},
        "mode": {"enum": ["exact", "contains_all", "contains_any"]},
        "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
      }
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clauses"],
      "properties": {
        "clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}}
      }
    }
  }
}

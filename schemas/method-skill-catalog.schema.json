{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/method-skill-catalog.schema.json",
  "title": "Market Impact Method Skill Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "methods"],
  "properties": {
    "schema_version": {"const": "market-impact.method-skill-catalog.v1"},
    "catalog_id": {
      "type": "string",
      "pattern": "^method-skill-catalog-[0-9a-f]{64}$"
    },
    "version": {"type": "string", "minLength": 1},
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/method"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "lineage",
        "source_refs",
        "applicable_market_states",
        "applicable_narratives",
        "analysis_needs",
        "required_evidence",
        "prohibited_uses",
        "priority"
      ],
      "properties": {
        "skill_name": {"$ref": "#/$defs/identifier"},
        "lineage": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri", "pattern": "^https://"}
        },
        "applicable_market_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["up_fast", "up_mild", "down_fast", "down_mild", "unclassified"]
          }
        },
        "applicable_narratives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "corroborated_obvious",
              "authority_obvious",
              "diffuse",
              "contested",
              "unavailable"
            ]
          }
        },
        "analysis_needs": {"$ref": "#/$defs/identifiers"},
        "required_evidence": {"$ref": "#/$defs/identifiers"},
        "prohibited_uses": {"$ref": "#/$defs/identifiers"},
        "priority": {"type": "integer", "minimum": 1}
      }
    }
  }
}

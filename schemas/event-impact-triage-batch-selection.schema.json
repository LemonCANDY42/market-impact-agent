{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/event-impact-triage-batch-selection.schema.json",
  "title": "Market Impact Event Impact Triage Batch Selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "readiness_report_id",
    "checkpoint_key",
    "selected_at",
    "maximum_candidate_count",
    "candidates",
    "selected_version_ids",
    "historical_pit_claim",
    "judgment_model_calls_authorized",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.event-impact-triage-batch-selection.v1"},
    "selection_id": {
      "type": "string",
      "pattern": "^event-impact-triage-batch-selection-[0-9a-f]{64}$"
    },
    "readiness_report_id": {
      "type": "string",
      "pattern": "^prospective-checkpoint-readiness-report-[0-9a-f]{64}$"
    },
    "checkpoint_key": {"type": "string", "minLength": 1},
    "selected_at": {"type": "string", "format": "date-time"},
    "maximum_candidate_count": {"type": "integer", "minimum": 1, "maximum": 128},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "selected_version_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/version_id"}
    },
    "historical_pit_claim": {"const": false},
    "judgment_model_calls_authorized": {"const": false},
    "execution_capability": {"const": false}
  },
  "$defs": {
    "version_id": {
      "type": "string",
      "pattern": "^prospective-observation-version-[0-9a-f]{64}$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "first_available_at",
        "provider_id",
        "provider_version",
        "upstream_source"
      ],
      "properties": {
        "version_id": {"$ref": "#/$defs/version_id"},
        "first_available_at": {"type": "string", "format": "date-time"},
        "provider_id": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "upstream_source": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/strategy-backtest-outcome-receipt.schema.json",
  "title": "Strategy Backtest Outcome Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "harness_authority_id", "case_id", "arm",
    "strategy_variant_hash", "strategy_ref", "target_selection_ref", "engine_config_hash", "simulation",
    "result_hash", "result_artifact_hash", "manifest_hash", "request_hash", "input_hashes",
    "source_snapshot_id", "source_snapshot_artifact_hash", "universe_hash", "cost_model_hash",
    "fill_model_hash", "capital_path", "adverse_excursion_path", "fills", "costs", "net_return", "net_pnl",
    "portfolio_net_return", "max_drawdown", "cvar95", "sharpe", "sortino", "turnover",
    "adverse_excursion", "liquidity_cost", "stressed_net_return",
    "stress_evidence_artifact_hash", "missing_metrics"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.strategy-backtest-outcome.v1"},
    "receipt_id": {"type": "string", "pattern": "^strategy-backtest-outcome-[0-9a-f]{64}$"},
    "harness_authority_id": {"type": "string", "pattern": "^harness-authority-[0-9a-f]{32}$"},
    "case_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["candidate", "primary_baseline"]},
    "strategy_variant_hash": {"$ref": "#/$defs/sha256"},
    "strategy_ref": {"type": "string", "minLength": 1},
    "target_selection_ref": {"type": "string", "minLength": 1},
    "engine_config_hash": {"$ref": "#/$defs/sha256"},
    "simulation": {"$ref": "#/$defs/simulation"},
    "result_hash": {"$ref": "#/$defs/sha256"},
    "result_artifact_hash": {"$ref": "#/$defs/sha256"},
    "manifest_hash": {"$ref": "#/$defs/sha256"},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "input_hashes": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"],
        "properties": {"name": {"type": "string", "minLength": 1}, "value": {"$ref": "#/$defs/sha256"}}}
    },
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "source_snapshot_artifact_hash": {"$ref": "#/$defs/sha256"},
    "universe_hash": {"$ref": "#/$defs/sha256"},
    "cost_model_hash": {"$ref": "#/$defs/sha256"},
    "fill_model_hash": {"$ref": "#/$defs/sha256"},
    "capital_path": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/capital_point"}},
    "adverse_excursion_path": {"type": "array", "items": {"$ref": "#/$defs/adverse_excursion_point"}},
    "fills": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/fill"}},
    "costs": {"type": "array", "items": {"$ref": "#/$defs/cost"}},
    "net_return": {"$ref": "#/$defs/decimal"},
    "net_pnl": {"$ref": "#/$defs/decimal"},
    "portfolio_net_return": {"$ref": "#/$defs/decimal"},
    "max_drawdown": {"$ref": "#/$defs/nullable_decimal"},
    "cvar95": {"$ref": "#/$defs/nullable_decimal"},
    "sharpe": {"$ref": "#/$defs/nullable_decimal"},
    "sortino": {"$ref": "#/$defs/nullable_decimal"},
    "turnover": {"$ref": "#/$defs/decimal"},
    "adverse_excursion": {"$ref": "#/$defs/decimal"},
    "liquidity_cost": {"$ref": "#/$defs/decimal"},
    "stressed_net_return": {"$ref": "#/$defs/nullable_decimal"},
    "stress_evidence_artifact_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "missing_metrics": {"type": "array", "items": {"$ref": "#/$defs/missing_metric"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullable_decimal": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "simulation": {"type": "object", "additionalProperties": false,
      "required": ["data_granularity", "book_type", "fill_model", "fee_model", "venue_ruleset", "base_currency", "starting_cash", "random_seed"],
      "properties": {
        "data_granularity": {"type": "string", "minLength": 1},
        "book_type": {"type": "string", "minLength": 1},
        "fill_model": {"type": "string", "minLength": 1},
        "fee_model": {"type": "string", "minLength": 1},
        "venue_ruleset": {"type": "string", "minLength": 1},
        "base_currency": {"type": "string", "minLength": 1},
        "starting_cash": {"$ref": "#/$defs/decimal"},
        "random_seed": {"type": "integer", "minimum": 0}
      }},
    "capital_point": {"type": "object", "additionalProperties": false, "required": ["observed_at", "equity"], "properties": {"observed_at": {"type": "string", "format": "date-time"}, "equity": {"$ref": "#/$defs/decimal"}}},
    "adverse_excursion_point": {"type": "object", "additionalProperties": false, "required": ["observed_at", "adverse_excursion"], "properties": {"observed_at": {"type": "string", "format": "date-time"}, "adverse_excursion": {"$ref": "#/$defs/decimal"}}},
    "fill": {"type": "object", "additionalProperties": false, "required": ["side", "filled_at", "quantity", "price", "commission", "available_liquidity_quantity"], "properties": {"side": {"enum": ["buy", "sell"]}, "filled_at": {"type": "string", "format": "date-time"}, "quantity": {"$ref": "#/$defs/decimal"}, "price": {"$ref": "#/$defs/decimal"}, "commission": {"$ref": "#/$defs/decimal"}, "available_liquidity_quantity": {"$ref": "#/$defs/nullable_decimal"}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["name", "amount", "currency"], "properties": {"name": {"type": "string", "minLength": 1}, "amount": {"$ref": "#/$defs/decimal"}, "currency": {"type": "string", "minLength": 1}}},
    "missing_metric": {"type": "object", "additionalProperties": false, "required": ["name", "reason"], "properties": {"name": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}
  }
}

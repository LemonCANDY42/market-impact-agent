{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/decision-review-schedule-v1.schema.json",
  "title": "Deterministic decision review schedule v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "schedule_id", "root_event_id", "thesis_epoch", "cadence",
    "primary_horizon_sessions", "created_at", "review_points", "maximum_intermediate_wakes"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.decision-review-schedule.v1"},
    "schedule_id": {"type": "string", "pattern": "^decision-review-schedule-v1-[0-9a-f]{64}$"},
    "root_event_id": {"type": "string", "minLength": 1},
    "thesis_epoch": {"type": "string", "minLength": 1},
    "cadence": {"enum": ["one_shot", "scheduled", "material_event_driven"]},
    "primary_horizon_sessions": {"enum": [1, 3, 5, 10, 20, 60]},
    "created_at": {"type": "string", "format": "date-time"},
    "review_points": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["session_offset", "session_date", "trigger"],
        "properties": {
          "session_offset": {"type": "integer", "minimum": 1, "maximum": 60},
          "session_date": {"type": "string", "format": "date"},
          "trigger": {"enum": ["scheduled", "terminal"]}
        }
      }
    },
    "maximum_intermediate_wakes": {"enum": [0, 3]}
  }
}

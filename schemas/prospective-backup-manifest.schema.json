{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/prospective-backup-manifest.schema.json",
  "title": "Market Impact Prospective Backup Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "files",
    "sqlite_table_counts",
    "data_snapshot_ids",
    "collection_policy_ids",
    "dataset_row_counts",
    "sqlite_integrity_ok",
    "foreign_keys_ok",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.prospective-backup-manifest.v1"},
    "manifest_id": {
      "type": "string",
      "pattern": "^prospective-backup-manifest-[0-9a-f]{64}$"
    },
    "created_at": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "content_hash", "size_bytes"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "sqlite_table_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "data_snapshot_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^data-snapshot-[0-9a-f]{64}$"}
    },
    "collection_policy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^prospective-collection-policy-[0-9a-f]{64}$"
      }
    },
    "dataset_row_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "sqlite_integrity_ok": {"const": true},
    "foreign_keys_ok": {"const": true},
    "execution_capability": {"const": false}
  }
}

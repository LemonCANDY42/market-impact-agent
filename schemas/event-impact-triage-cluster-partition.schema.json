{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/event-impact-triage-cluster-partition.schema.json",
  "title": "Market Impact Event Impact Triage Cluster Partition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "partition_id",
    "manifest_id",
    "manifest_hash",
    "ordered_digest_ids",
    "ordered_candidate_version_ids",
    "clusters",
    "historical_pit_claim",
    "judgment_model_calls_authorized",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.event-impact-triage-cluster-partition.v1"},
    "partition_id": {"type": "string", "pattern": "^event-impact-triage-cluster-partition-[0-9a-f]{64}$"},
    "manifest_id": {"type": "string", "pattern": "^event-impact-triage-work-manifest-[0-9a-f]{64}$"},
    "manifest_hash": {"$ref": "#/$defs/sha256"},
    "ordered_digest_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digestId"}
    },
    "ordered_candidate_version_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/versionId"}
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/cluster"}
    },
    "historical_pit_claim": {"const": false},
    "judgment_model_calls_authorized": {"const": false},
    "execution_capability": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digestId": {"type": "string", "pattern": "^event-impact-triage-candidate-digest-[0-9a-f]{64}$"},
    "atomId": {"type": "string", "pattern": "^event-impact-triage-work-atom-[0-9a-f]{64}$"},
    "versionId": {"type": "string", "pattern": "^prospective-observation-version-[0-9a-f]{64}$"},
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "not": {
        "pattern": "(?i)(gold[ _-]*label|label[ _-]*set[ _-]*id|checkpoint[ _-]*eligibility|expected[ _-]*route|recommended[ _-]*route|must[ _-]*catch|material[ _-]*transmission[ _-]*expected|batch[ _-]*gate[ _-]*passed|promotion[ _-]*eligible|\\beligible\\b|\\bineligible\\b|needs[ _-]*review|checkpoint[ _-]*candidate|event[ _-]*assessment|attention[ _-]*watch|signal[ _-]*intent|order[ _-]*intent|trading[ _-]*mandate|approval[ _-]*decision|historical[ _-]*pit[ _-]*claim|judgment[ _-]*model[ _-]*calls[ _-]*authorized|execution[ _-]*capability)"
      }
    },
    "texts": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_seed_id",
        "digest_ids",
        "atom_ids",
        "candidate_version_ids",
        "merge_state",
        "merge_evidence",
        "uncertainty_notes"
      ],
      "properties": {
        "cluster_seed_id": {"type": "string", "pattern": "^event-impact-triage-cluster-seed-[0-9a-f]{64}$"},
        "digest_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digestId"}
        },
        "atom_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/atomId"}
        },
        "candidate_version_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/versionId"}
        },
        "merge_state": {"enum": ["merged", "needs_review"]},
        "merge_evidence": {"$ref": "#/$defs/texts"},
        "uncertainty_notes": {"$ref": "#/$defs/texts"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "merge_state": {"const": "merged"},
              "atom_ids": {"minItems": 2}
            },
            "required": ["merge_state", "atom_ids"]
          },
          "then": {"properties": {"merge_evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"merge_state": {"const": "needs_review"}}},
          "then": {"properties": {"uncertainty_notes": {"minItems": 1}}}
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/prospective-dataset-manifest.schema.json",
  "title": "Market Impact Prospective Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "data_snapshot_id",
    "policy_id",
    "window_start",
    "cutoff_at",
    "coverage_complete",
    "observation_count",
    "collection_snapshot_ids",
    "partitions",
    "parquet_writer",
    "compression"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.prospective-dataset-manifest.v1"},
    "dataset_id": {
      "type": "string",
      "pattern": "^prospective-dataset-[0-9a-f]{64}$"
    },
    "data_snapshot_id": {
      "type": "string",
      "pattern": "^data-snapshot-[0-9a-f]{64}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^prospective-collection-policy-[0-9a-f]{64}$"
    },
    "window_start": {"type": "string", "format": "date-time"},
    "cutoff_at": {"type": "string", "format": "date-time"},
    "coverage_complete": {"const": true},
    "observation_count": {"type": "integer", "minimum": 0},
    "collection_snapshot_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^data-snapshot-[0-9a-f]{64}$"}
    },
    "partitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/partition"}
    },
    "parquet_writer": {"type": "string", "minLength": 1},
    "compression": {"const": "zstd"}
  },
  "$defs": {
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "available_date",
        "content_hash",
        "row_count",
        "size_bytes",
        "relative_path"
      ],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "available_date": {"type": "string", "format": "date"},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "row_count": {"type": "integer", "minimum": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "relative_path": {
          "type": "string",
          "pattern": "^parquet/[^/]+/available_date=[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9a-f]{64}\\.parquet$"
        }
      }
    }
  }
}

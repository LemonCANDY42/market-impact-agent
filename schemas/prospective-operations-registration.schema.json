{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/prospective-operations-registration.schema.json",
  "title": "Market Impact Prospective Operations Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registration_id",
    "registered_at",
    "required_job_ids",
    "required_supervisor_receipt_id",
    "required_checkpoint_snapshot_set_ids",
    "required_faults",
    "soak_duration_seconds",
    "maximum_state_bytes",
    "maximum_lag_seconds",
    "maximum_freeze_latency_ms",
    "maximum_query_latency_ms",
    "minimum_compression_ratio",
    "backup_retention_count",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.prospective-operations-registration.v1"},
    "registration_id": {
      "type": "string",
      "pattern": "^prospective-operations-registration-[0-9a-f]{64}$"
    },
    "registered_at": {"type": "string", "format": "date-time"},
    "required_job_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^prospective-collection-job-[0-9a-f]{64}$"
      }
    },
    "required_supervisor_receipt_id": {
      "type": "string",
      "pattern": "^prospective-supervisor-receipt-[0-9a-f]{64}$"
    },
    "required_checkpoint_snapshot_set_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^prospective-checkpoint-snapshot-set-[0-9a-f]{64}$"
      }
    },
    "required_faults": {
      "const": [
        "restart",
        "rate_limit",
        "corrupted_backup",
        "stale_source",
        "disk_budget_pressure",
        "restore"
      ]
    },
    "soak_duration_seconds": {"type": "integer", "minimum": 1},
    "maximum_state_bytes": {"type": "integer", "minimum": 1},
    "maximum_lag_seconds": {"type": "integer", "minimum": 1},
    "maximum_freeze_latency_ms": {"type": "integer", "minimum": 1},
    "maximum_query_latency_ms": {"type": "integer", "minimum": 1},
    "minimum_compression_ratio": {"type": "number", "minimum": 1},
    "backup_retention_count": {"type": "integer", "minimum": 1},
    "execution_capability": {"const": false}
  }
}

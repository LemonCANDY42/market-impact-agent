{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/data-query.schema.json",
  "title": "Market Impact Data Query",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query_id",
    "capability",
    "pit_lane",
    "as_of",
    "window_start",
    "source_policy_id",
    "parameters",
    "sources",
    "minimum_data_sources"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.data-query.v1"},
    "query_id": {"type": "string", "pattern": "^data-query-[0-9a-f]{64}$"},
    "capability": {
      "enum": [
        "event_revelation",
        "prior_expectation",
        "market_context",
        "exposure_candidates",
        "positioning",
        "macro_vintage",
        "prediction_market_discovery",
        "prediction_market_snapshot",
        "prediction_market_history"
      ]
    },
    "pit_lane": {"enum": ["strict", "modeled", "prospective"]},
    "as_of": {"type": "string", "format": "date-time"},
    "window_start": {
      "oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]
    },
    "source_policy_id": {"type": "string", "minLength": 1},
    "parameters": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "provider_version",
          "upstream_source",
          "manifest_hash",
          "required"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "provider_version": {"type": "string", "minLength": 1},
          "upstream_source": {"type": "string", "minLength": 1},
          "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required": {"type": "boolean"}
        }
      }
    },
    "minimum_data_sources": {"type": "integer", "minimum": 1}
  }
}

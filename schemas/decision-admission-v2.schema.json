{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/decision-admission-v2.schema.json",
  "title": "Market Impact Portfolio-Bound Decision Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "admission_id", "disposition", "decision_run_manifest_id",
    "decision_run_manifest_hash", "query_gate_result_id", "query_gate_result_hash",
    "evidence_pack_id", "evidence_pack_hash", "signal_id", "signal_intent_hash",
    "order_intent_hash", "agreeing_judgment_artifact_ids", "paper_approval_mode",
    "created_at", "claim_scope", "alpha_claim", "live_capability", "execution_authority",
    "authorized_decision_view_id", "authorized_decision_view_hash",
    "account_state_snapshot_id", "account_state_snapshot_hash",
    "position_snapshot_id", "position_snapshot_hash", "portfolio_decision_id",
    "portfolio_decision_hash", "order_sizing_decision_id", "order_sizing_decision_hash"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.decision-admission.v2"},
    "admission_id": {"type": "string", "pattern": "^decision-admission-[0-9a-f]{64}$"},
    "disposition": {"const": "propose"},
    "decision_run_manifest_id": {"type": "string", "pattern": "^decision-run-manifest-[0-9a-f]{64}$"},
    "decision_run_manifest_hash": {"$ref": "#/$defs/sha256"},
    "query_gate_result_id": {"type": "string", "pattern": "^prospective-query-gate-[0-9a-f]{64}$"},
    "query_gate_result_hash": {"$ref": "#/$defs/sha256"},
    "evidence_pack_id": {"type": "string", "pattern": "^evidence-pack-[0-9a-f]{64}$"},
    "evidence_pack_hash": {"$ref": "#/$defs/sha256"},
    "signal_id": {"type": "string", "pattern": "^signal-.+$"},
    "signal_intent_hash": {"$ref": "#/$defs/sha256"},
    "order_intent_hash": {"$ref": "#/$defs/sha256"},
    "agreeing_judgment_artifact_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^judgment-[0-9a-f]{64}$"}},
    "paper_approval_mode": {"const": "manual_each"},
    "created_at": {"type": "string", "format": "date-time"},
    "claim_scope": {"const": "execution_diagnostic_only_no_alpha_or_live_claim"},
    "alpha_claim": {"const": false},
    "live_capability": {"const": false},
    "execution_authority": {"const": false},
    "authorized_decision_view_id": {"type": "string", "pattern": "^authorized-decision-view-[0-9a-f]{64}$"},
    "authorized_decision_view_hash": {"$ref": "#/$defs/sha256"},
    "account_state_snapshot_id": {"type": "string", "pattern": "^account-state-snapshot-[0-9a-f]{64}$"},
    "account_state_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "position_snapshot_id": {"type": "string", "pattern": "^position-snapshot-[0-9a-f]{64}$"},
    "position_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "portfolio_decision_id": {"type": "string", "pattern": "^portfolio-decision-[0-9a-f]{64}$"},
    "portfolio_decision_hash": {"$ref": "#/$defs/sha256"},
    "order_sizing_decision_id": {"type": "string", "pattern": "^order-sizing-decision-[0-9a-f]{64}$"},
    "order_sizing_decision_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

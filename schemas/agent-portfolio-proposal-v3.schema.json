{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-impact.local/schemas/agent-portfolio-proposal-v3.schema.json",
  "title": "Account-aware portfolio recommendation v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "review_binding_hash", "requested_action", "rationale", "horizon_sessions", "evidence_refs", "counterevidence_refs", "invalidation_conditions", "instrument_id", "venue", "instrument_class", "direction", "target_gross_exposure_ratio"],
  "properties": {
    "schema_version": {"const": "market-impact.agent-portfolio-proposal.v3"},
    "proposal_id": {"type": "string", "pattern": "^agent-portfolio-proposal-v3-[a-f0-9]{64}$"},
    "review_binding_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_action": {"enum": ["hold", "open", "increase", "reduce", "close", "rotate"]},
    "rationale": {"type": "string", "minLength": 1},
    "horizon_sessions": {"type": "integer", "minimum": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counterevidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "instrument_id": {"type": ["string", "null"]},
    "venue": {"type": ["string", "null"]},
    "instrument_class": {"type": ["string", "null"]},
    "direction": {"enum": ["long", "short", null]},
    "target_gross_exposure_ratio": {"type": ["string", "null"], "pattern": "^(0(?:\\.[0-9]+)?|1(?:\\.0+)?)$"}
  },
  "allOf": [{
    "if": {"properties": {"requested_action": {"const": "hold"}}},
    "then": {"properties": {"instrument_id": {"type": "null"}, "venue": {"type": "null"}, "instrument_class": {"type": "null"}, "direction": {"type": "null"}, "target_gross_exposure_ratio": {"type": "null"}}},
    "else": {"properties": {"instrument_id": {"type": "string", "minLength": 1}, "venue": {"type": "string", "minLength": 1}, "instrument_class": {"type": "string", "minLength": 1}, "direction": {"enum": ["long", "short"]}, "target_gross_exposure_ratio": {"type": "string"}}}
  }]
}

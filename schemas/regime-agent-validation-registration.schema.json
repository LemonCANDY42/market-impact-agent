{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-impact-agent.local/schemas/regime-agent-validation-registration.schema.json",
  "title": "Regime Agent Validation Registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "version",
    "dataset_id",
    "dataset_hash",
    "study_registration_id",
    "study_registration_hash",
    "panel_id",
    "manifest_id",
    "qualification_report_id",
    "provider_profile_id",
    "replicate_count",
    "total_cost_cap_microusd",
    "outcomes_opened",
    "selection_rule",
    "cases",
    "inference_eligible",
    "broker_reachability",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.regime-agent-validation-registration.v1"},
    "validation_id": {
      "type": "string",
      "pattern": "^regime-agent-validation-[0-9a-f]{64}$"
    },
    "version": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "study_registration_id": {"type": "string", "minLength": 1},
    "study_registration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "panel_id": {"type": "string", "pattern": "^regime-panel-[0-9a-f]{64}$"},
    "manifest_id": {
      "type": "string",
      "pattern": "^regime-evidence-manifest-[0-9a-f]{64}$"
    },
    "qualification_report_id": {
      "type": "string",
      "pattern": "^regime-evidence-qualification-report-[0-9a-f]{64}$"
    },
    "provider_profile_id": {"type": "string", "minLength": 1},
    "replicate_count": {"const": 3},
    "total_cost_cap_microusd": {"type": "integer", "minimum": 1, "maximum": 20000000},
    "outcomes_opened": {"const": true},
    "selection_rule": {"const": "registered_window_first_middle_last"},
    "cases": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"}
    },
    "inference_eligible": {"const": false},
    "broker_reachability": {"const": false},
    "execution_capability": {"const": "none"}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_key",
        "treatment_skill",
        "window_start",
        "window_end",
        "checkpoints"
      ],
      "properties": {
        "case_key": {"type": "string", "minLength": 1},
        "treatment_skill": {"type": "string", "minLength": 1},
        "window_start": {"type": "string", "format": "date"},
        "window_end": {"type": "string", "format": "date"},
        "checkpoints": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "format": "date"}
        }
      }
    }
  }
}

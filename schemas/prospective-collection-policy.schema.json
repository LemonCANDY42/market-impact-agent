{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/prospective-collection-policy.schema.json",
  "title": "Market Impact Prospective Collection Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "capability",
    "sources",
    "window_start",
    "parameters",
    "poll_interval_seconds",
    "maximum_gap_seconds"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "market-impact.prospective-collection-policy.v1",
        "market-impact.prospective-collection-policy.v2"
      ]
    },
    "policy_id": {
      "type": "string",
      "pattern": "^prospective-collection-policy-[0-9a-f]{64}$"
    },
    "capability": {
      "enum": [
        "event_revelation",
        "prior_expectation",
        "market_context",
        "exposure_candidates",
        "positioning",
        "macro_vintage",
        "prediction_market_discovery",
        "prediction_market_snapshot",
        "prediction_market_history"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "window_start": {"type": "string", "format": "date-time"},
    "parameters": {"type": "object"},
    "poll_interval_seconds": {"type": "integer", "minimum": 1},
    "maximum_gap_seconds": {"type": "integer", "minimum": 1},
    "rolling_window": {"$ref": "#/$defs/rolling_window"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "market-impact.prospective-collection-policy.v1"}
        }
      },
      "then": {"not": {"required": ["rolling_window"]}}
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "market-impact.prospective-collection-policy.v2"}
        }
      },
      "then": {"required": ["rolling_window"]}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rolling_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookback_seconds",
        "timezone",
        "start_parameter",
        "end_parameter",
        "datetime_format"
      ],
      "properties": {
        "lookback_seconds": {"type": "integer", "minimum": 1},
        "timezone": {"type": "string", "minLength": 1},
        "start_parameter": {"type": "string", "minLength": 1},
        "end_parameter": {"type": "string", "minLength": 1},
        "datetime_format": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "provider_version",
        "upstream_source",
        "manifest_hash",
        "source_config_hash",
        "required"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "provider_version": {"type": "string", "minLength": 1},
        "upstream_source": {"type": "string", "minLength": 1},
        "manifest_hash": {"$ref": "#/$defs/sha256"},
        "source_config_hash": {"$ref": "#/$defs/sha256"},
        "required": {"type": "boolean"}
      }
    }
  }
}

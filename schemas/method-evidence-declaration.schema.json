{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/method-evidence-declaration.schema.json",
  "title": "Market Impact Method Evidence Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "declaration_id",
    "evidence_pack_id",
    "evidence_pack_hash",
    "evidence_types",
    "outcomes_opened"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.method-evidence-declaration.v1"},
    "declaration_id": {
      "type": "string",
      "pattern": "^method-evidence-[0-9a-f]{64}$"
    },
    "evidence_pack_id": {
      "type": "string",
      "pattern": "^evidence-pack-[0-9a-f]{64}$"
    },
    "evidence_pack_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "evidence_refs", "pattern_pack_refs"],
        "properties": {
          "evidence_type": {"$ref": "#/$defs/identifier"},
          "evidence_refs": {"$ref": "#/$defs/identifiers"},
          "pattern_pack_refs": {"$ref": "#/$defs/identifiers"}
        },
        "anyOf": [
          {"properties": {"evidence_refs": {"minItems": 1}}},
          {"properties": {"pattern_pack_refs": {"minItems": 1}}}
        ]
      }
    },
    "outcomes_opened": {"type": "boolean"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  }
}

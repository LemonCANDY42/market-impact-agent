{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/monitoring-scope.schema.json",
  "title": "Market Impact Monitoring Scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope_id", "origin_refs", "subject", "query_template_ref", "capability", "pit_lane", "freshness_max_age_seconds", "minimum_coverage_sources", "maximum_fetches", "maximum_bytes", "use_class", "matcher"],
  "properties": {
    "schema_version": {"const": "market-impact.monitoring-scope.v1"},
    "scope_id": {"type": "string", "pattern": "^monitoring-scope-[0-9a-f]{64}$"},
    "origin_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonical_ref"}},
    "subject": {"$ref": "#/$defs/subject"},
    "frozen_members": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/subject"}},
    "effective_context": {"$ref": "#/$defs/effective_context"},
    "query_template_ref": {"type": "string", "pattern": "^monitoring-query-template-[0-9a-f]{64}$"},
    "information_aspect_ref": {"type": "string", "pattern": "^information-aspect-[0-9a-f]{64}$"},
    "capability": {"$ref": "#/$defs/capability"},
    "pit_lane": {"enum": ["strict", "modeled", "prospective", "retrospective"]},
    "freshness_max_age_seconds": {"type": "integer", "minimum": 0},
    "minimum_coverage_sources": {"type": "integer", "minimum": 1},
    "maximum_fetches": {"type": "integer", "minimum": 0},
    "maximum_bytes": {"type": "integer", "minimum": 0},
    "use_class": {"enum": ["public", "private_internal", "licensed_internal"]},
    "matcher": {"$ref": "#/$defs/matcher"}
  },
  "allOf": [
    {"if": {"properties": {"subject": {"properties": {"kind": {"const": "frozen_set"}}}}}, "then": {"required": ["frozen_members"], "properties": {"frozen_members": {"minItems": 1}}}, "else": {"not": {"required": ["frozen_members"]}}},
    {"if": {"properties": {"subject": {"properties": {"kind": {"enum": ["industry", "etf"]}}}}}, "then": {"required": ["effective_context"]}, "else": {"not": {"required": ["effective_context"]}}},
    {"if": {"properties": {"subject": {"properties": {"kind": {"const": "information_aspect"}}}}}, "then": {"required": ["information_aspect_ref"]}}
  ],
  "$defs": {
    "canonical_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{1,127}$"},
    "subject": {"type": "object", "additionalProperties": false, "required": ["kind", "canonical_id"], "properties": {"kind": {"enum": ["event_cluster", "industry", "issuer", "instrument", "etf", "frozen_set", "information_aspect"]}, "canonical_id": {"$ref": "#/$defs/canonical_ref"}}},
    "effective_context": {"type": "object", "additionalProperties": false, "required": ["taxonomy_ref", "mapping_ref", "effective_at"], "properties": {"taxonomy_ref": {"type": "string", "pattern": "^taxonomy-[0-9a-f]{64}$"}, "mapping_ref": {"type": "string", "pattern": "^membership-mapping-[0-9a-f]{64}$"}, "effective_at": {"type": "string", "format": "date-time"}}},
    "matcher": {"type": "object", "additionalProperties": false, "required": ["clauses"], "properties": {"clauses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clause"}}}},
    "clause": {"type": "object", "additionalProperties": false, "required": ["field_path", "mode", "terms"], "properties": {"field_path": {"enum": ["event_cluster_ids", "industry_codes", "issuer_ids", "instrument_ids", "etf_ids", "subject_refs", "information_aspects", "tags", "headline", "title", "content", "channels", "ts_code", "record.title", "record.headline", "record.content", "record.channels", "record.ts_code"]}, "mode": {"enum": ["exact", "contains_all", "contains_any"]}, "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}},
    "capability": {"enum": ["event_revelation", "prior_expectation", "market_context", "exposure_candidates", "positioning", "macro_vintage", "prediction_market_discovery", "prediction_market_snapshot", "prediction_market_history"]}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/strategy-case-run-plan-v2.schema.json",
  "title": "Strategy Case Run Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "run_id", "harness_authority_id", "registration_id", "registration_hash", "strategy_epoch_id", "case_id", "root_event_id", "regime", "role", "evidence_lane", "input_hash", "data_snapshot_hash", "evidence_lineage_hash", "qualification_report_hash", "admission_hash", "evidence_owner_id", "evidence_owner_hash", "evidence_unavailable_reason", "model_profile_hash", "prompt_hash", "skill_catalog_hash", "tool_manifest_hash", "universe_hash", "cost_model_hash", "fill_model_hash", "primary_baseline_id", "primary_baseline_definition_hash", "primary_baseline_configuration_hash", "development_selection_evidence_hash"],
  "properties": {
    "schema_version": {"const": "market-impact.strategy-case-run-plan.v2"},
    "plan_id": {"type": "string", "pattern": "^strategy-case-run-plan-[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "harness_authority_id": {"type": "string", "pattern": "^harness-authority-[0-9a-f]{32}$"},
    "registration_id": {"type": "string", "pattern": "^strategy-validation-registration-[0-9a-f]{64}$"},
    "registration_hash": {"$ref": "#/$defs/sha256"},
    "strategy_epoch_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "root_event_id": {"type": "string", "minLength": 1},
    "regime": {"type": "string", "minLength": 1},
    "role": {"enum": ["development", "historical_holdout", "prospective_confirmation"]},
    "evidence_lane": {"enum": ["retrospective", "modeled_pit", "strict_pit", "prospective_actual_receipt"]},
    "input_hash": {"$ref": "#/$defs/sha256"}, "data_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "evidence_lineage_hash": {"$ref": "#/$defs/sha256"}, "qualification_report_hash": {"$ref": "#/$defs/sha256"},
    "admission_hash": {"$ref": "#/$defs/sha256"},
    "evidence_owner_id": {"type": ["string", "null"], "minLength": 1},
    "evidence_owner_hash": {"$ref": "#/$defs/sha256"},
    "evidence_unavailable_reason": {"type": ["string", "null"], "minLength": 1},
    "model_profile_hash": {"$ref": "#/$defs/sha256"},
    "prompt_hash": {"$ref": "#/$defs/sha256"}, "skill_catalog_hash": {"$ref": "#/$defs/sha256"},
    "tool_manifest_hash": {"$ref": "#/$defs/sha256"}, "universe_hash": {"$ref": "#/$defs/sha256"},
    "cost_model_hash": {"$ref": "#/$defs/sha256"}, "fill_model_hash": {"$ref": "#/$defs/sha256"},
    "primary_baseline_id": {"type": "string", "minLength": 1},
    "primary_baseline_definition_hash": {"$ref": "#/$defs/sha256"},
    "primary_baseline_configuration_hash": {"$ref": "#/$defs/sha256"},
    "development_selection_evidence_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}

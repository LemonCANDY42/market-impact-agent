{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/research-method-catalog.schema.json",
  "title": "Market Impact Research Method Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "methods"],
  "properties": {
    "schema_version": {"const": "market-impact.research-method-catalog.v1"},
    "catalog_id": {
      "type": "string",
      "pattern": "^research-method-catalog-[0-9a-f]{64}$"
    },
    "version": {"type": "string", "minLength": 1},
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skill_name",
          "layer",
          "asset_classes",
          "mechanism_families",
          "requires_pattern_pack",
          "priority"
        ],
        "properties": {
          "skill_name": {"$ref": "#/$defs/identifier"},
          "layer": {
            "enum": [
              "evidence",
              "event_context",
              "equity_exposure",
              "adversarial_risk",
              "pattern",
              "family"
            ]
          },
          "asset_classes": {"$ref": "#/$defs/identifiers"},
          "mechanism_families": {"$ref": "#/$defs/identifiers"},
          "requires_pattern_pack": {"type": "boolean"},
          "priority": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    }
  }
}

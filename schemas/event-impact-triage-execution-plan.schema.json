{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/event-impact-triage-execution-plan.schema.json",
  "title": "Market Impact Event Impact Triage Execution Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "arm",
    "candidate_set_id",
    "registration_id",
    "checkpoint_key",
    "checkpoint_contract_hash",
    "data_snapshot_id",
    "candidate_content_view",
    "model_profile_alias",
    "model_provider_profile",
    "role_bindings",
    "position_snapshot_id",
    "historical_analogy_pack_id",
    "max_child_count",
    "max_total_input_tokens",
    "max_total_output_tokens",
    "max_total_estimated_cost_microusd",
    "allowed_tools",
    "allowed_mcp_servers",
    "historical_pit_claim",
    "judgment_model_calls_authorized",
    "execution_capability"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "market-impact.event-impact-triage-execution-plan.v1",
        "market-impact.event-impact-triage-execution-plan.v2"
      ]
    },
    "plan_id": {
      "type": "string",
      "pattern": "^event-impact-triage-execution-plan-[0-9a-f]{64}$"
    },
    "arm": {"enum": ["coordinator_only", "bounded_specialists"]},
    "candidate_set_id": {
      "type": "string",
      "pattern": "^event-impact-triage-candidate-set-[0-9a-f]{64}$"
    },
    "registration_id": {
      "type": "string",
      "pattern": "^prospective-diagnostic-registration-[0-9a-f]{64}$"
    },
    "checkpoint_key": {"type": "string", "minLength": 1},
    "checkpoint_contract_hash": {"$ref": "#/$defs/sha256"},
    "data_snapshot_id": {"type": "string", "pattern": "^data-snapshot-[0-9a-f]{64}$"},
    "candidate_content_view": {"const": "normalized-observation-payload-v1"},
    "model_profile_alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "model_provider_profile": {
      "$ref": "https://schemas.market-impact-agent.local/model-provider-profile.schema.json"
    },
    "role_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/roleBinding"}
    },
    "position_snapshot_id": {
      "type": ["string", "null"],
      "pattern": "^position-snapshot-[0-9a-f]{64}$"
    },
    "historical_analogy_pack_id": {
      "type": ["string", "null"],
      "pattern": "^historical-analogy-pack-[0-9a-f]{64}$"
    },
    "max_child_count": {"type": "integer", "minimum": 0},
    "max_total_input_tokens": {"type": "integer", "minimum": 1},
    "max_total_output_tokens": {"type": "integer", "minimum": 1},
    "max_total_estimated_cost_microusd": {"type": "integer", "minimum": 0},
    "allowed_tools": {"type": "array", "maxItems": 0},
    "allowed_mcp_servers": {"type": "array", "maxItems": 0},
    "historical_pit_claim": {"const": false},
    "judgment_model_calls_authorized": {"const": false},
    "execution_capability": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "market-impact.event-impact-triage-execution-plan.v1"
          }
        }
      },
      "then": {
        "properties": {
          "role_bindings": {
            "items": {"$ref": "#/$defs/roleBindingV1"}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "market-impact.event-impact-triage-execution-plan.v2"
          }
        }
      },
      "then": {
        "properties": {
          "role_bindings": {
            "items": {"$ref": "#/$defs/roleBindingV2"}
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "roleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "requested_skills",
        "resolved_skill_names",
        "skill_manifest_hashes",
        "prompt_template_id",
        "output_contract_hash",
        "max_turns",
        "max_input_tokens",
        "max_output_tokens",
        "max_estimated_cost_microusd"
      ],
      "properties": {
        "role": {
          "enum": [
            "coordinator",
            "fact_verifier",
            "transmission_mapper",
            "portfolio_impact",
            "historical_analogy",
            "countercase_reviewer"
          ]
        },
        "requested_skills": {"$ref": "#/$defs/strings"},
        "resolved_skill_names": {"$ref": "#/$defs/strings"},
        "skill_manifest_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "prompt_template_id": {"type": "string", "minLength": 1},
        "output_contract_hash": {"$ref": "#/$defs/sha256"},
        "max_turns": {"type": "integer", "minimum": 1},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_estimated_cost_microusd": {"type": "integer", "minimum": 0}
      }
    },
    "roleBindingV1": {
      "allOf": [
        {"$ref": "#/$defs/roleBinding"},
        {
          "properties": {
            "prompt_template_id": {"pattern": "-json-v1$"},
            "output_contract_hash": {
              "enum": [
                "97b4a0909e3ca1f517b130b5258f4b0938a54eaee636edea8802acbf36a895d6",
                "684f535502d10ff1d449e72fa761646f176398ba09d0c5824f8af4bcf8a95e7e",
                "3a2fabdd6ac8a0ae6cc40cffaae14dec1626b1397518cd9a5472ae8449dd1f14",
                "dce997eb543d0b64ef081199a4ec202c10e211e84005ec90cc5f69624985e602",
                "dc9daf45a94738c5e720f447b1f48e6db6e9c595001eb449578de6ed0a1a5c4d",
                "2a96390eb1e36410288b6d65377b0f000914d55f8a61596b23d52bb669dd6f1b"
              ]
            }
          }
        }
      ]
    },
    "roleBindingV2": {
      "allOf": [
        {"$ref": "#/$defs/roleBinding"},
        {
          "properties": {
            "prompt_template_id": {"pattern": "-json-v2$"},
            "output_contract_hash": {
              "enum": [
                "15c5374d2196548d104cc80fa0d916da9afa039d536e7df345575a2fb46d3059",
                "457968be915384562526bf7c7a9682811e036fb05aeac4619a1fabaae3541e87",
                "c2c7401dbf6c2d2b329dbe64ad35ce00edb08185e0a0ed719391617ede379dbc",
                "92e94e629e0d745156ec520ab5df863c8f395c2bd7698805cefa0a80cfa0684f",
                "673d6107a66478e4bf82c81db80d623a086913af89d3834d10de9fb8b3e9f750",
                "50567e07d897d81fabd6886d730a3393bb6776028a8ada0ad376a97e6ff48929"
              ]
            }
          }
        }
      ]
    }
  }
}

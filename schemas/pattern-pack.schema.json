{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/pattern-pack.schema.json",
  "title": "Market Impact Pattern Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "available_at", "entries"],
  "properties": {
    "schema_version": {"const": "market-impact.pattern-pack.v1"},
    "pack_id": {"type": "string", "pattern": "^pattern-[0-9a-f]{64}$"},
    "version": {"type": "string", "minLength": 1},
    "available_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pattern_entry"}
    }
  },
  "$defs": {
    "nonempty_unique_strings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pattern_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "mechanism",
        "transmission_scales",
        "applicability_conditions",
        "counterexamples",
        "evidence_refs"
      ],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "transmission_scales": {"$ref": "#/$defs/nonempty_unique_strings"},
        "applicability_conditions": {"$ref": "#/$defs/nonempty_unique_strings"},
        "counterexamples": {"$ref": "#/$defs/nonempty_unique_strings"},
        "evidence_refs": {"$ref": "#/$defs/nonempty_unique_strings"}
      }
    }
  }
}

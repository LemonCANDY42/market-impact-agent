{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LemonCANDY42/market-impact-agent/schemas/trading-mandate.schema.json",
  "title": "Market Impact Trading Mandate",
  "oneOf": [
    {"$ref": "#/$defs/v1"},
    {"$ref": "#/$defs/v2"}
  ],
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "positive_decimal": {"type": "string", "pattern": "^(?:0*[1-9][0-9]*|0*[0-9]*\\.[0-9]*[1-9][0-9]*)$"},
    "v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mandate_id", "account_id", "environment", "approval_mode", "valid_from", "expires_at", "allowed_instruments", "allowed_sides", "max_order_notional"],
      "properties": {
        "schema_version": {"const": "market-impact.trading-mandate.v1"},
        "mandate_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "environment": {"const": "paper"},
        "approval_mode": {"enum": ["disabled", "manual_each", "timeboxed", "policy_auto", "autonomous"]},
        "valid_from": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "allowed_instruments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_sides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["buy", "sell"]}},
        "max_order_notional": {"$ref": "#/$defs/positive_decimal"}
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "mandate_id", "account_id", "harness_authority_id", "environment", "approval_mode",
        "valid_from", "valid_until", "allowed_instruments", "allowed_instrument_classes",
        "allowed_sides", "currency", "gross_exposure_limit", "minimum_net_exposure",
        "maximum_net_exposure", "maximum_position_count", "maximum_single_position_fraction",
        "daily_turnover_limit", "daily_submission_limit", "daily_loss_kill_threshold",
        "strategy_peak_drawdown_kill_threshold", "kill_on_unknown_ack",
        "kill_on_stale_account_snapshot", "kill_on_incomplete_order_coverage",
        "kill_on_reconciliation_difference", "kill_on_provider_loss"
      ],
      "properties": {
        "schema_version": {"const": "market-impact.trading-mandate.v2"},
        "mandate_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "harness_authority_id": {"type": "string", "pattern": "^harness-authority-[0-9a-f]{32}$"},
        "environment": {"const": "paper"},
        "approval_mode": {"enum": ["disabled", "manual_each", "timeboxed", "policy_auto", "autonomous"]},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "allowed_instruments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_instrument_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cash_equity", "unlevered_exchange_traded_fund"]}},
        "allowed_sides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["buy", "sell"]}},
        "currency": {"const": "USD"},
        "gross_exposure_limit": {"$ref": "#/$defs/positive_decimal"},
        "minimum_net_exposure": {"$ref": "#/$defs/decimal"},
        "maximum_net_exposure": {"$ref": "#/$defs/decimal"},
        "maximum_position_count": {"type": "integer", "minimum": 1},
        "maximum_single_position_fraction": {"$ref": "#/$defs/positive_decimal"},
        "daily_turnover_limit": {"$ref": "#/$defs/positive_decimal"},
        "daily_submission_limit": {"type": "integer", "minimum": 1},
        "daily_loss_kill_threshold": {"$ref": "#/$defs/positive_decimal"},
        "strategy_peak_drawdown_kill_threshold": {"$ref": "#/$defs/positive_decimal"},
        "kill_on_unknown_ack": {"const": true},
        "kill_on_stale_account_snapshot": {"const": true},
        "kill_on_incomplete_order_coverage": {"const": true},
        "kill_on_reconciliation_difference": {"const": true},
        "kill_on_provider_loss": {"const": true}
      }
    }
  }
}

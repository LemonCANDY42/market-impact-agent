{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.market-impact-agent.local/common-crawl-locator.schema.json",
  "title": "Common Crawl WARC Locator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection",
    "target_url",
    "timestamp",
    "filename",
    "offset",
    "length",
    "digest",
    "http_status",
    "source_version_id"
  ],
  "properties": {
    "schema_version": {"const": "market-impact.common-crawl-locator.v1"},
    "collection": {"type": "string", "pattern": "^CC-MAIN-[0-9]{4}-[0-9]{2}$"},
    "target_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{14}$"},
    "filename": {
      "type": "string",
      "pattern": "^crawl-data/CC-MAIN-[0-9]{4}-[0-9]{2}/.+\\.warc\\.gz$"
    },
    "offset": {"type": "integer", "minimum": 0},
    "length": {"type": "integer", "minimum": 1, "maximum": 20971520},
    "digest": {"type": "string", "pattern": "^sha1:[A-Z2-7]{32}$"},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "source_version_id": {
      "type": "string",
      "pattern": "^common-crawl-record-[0-9a-f]{64}$"
    }
  }
}
